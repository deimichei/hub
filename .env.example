# Modello del file .env: copialo in ".env" e compila i valori.
# Il file .env contiene dati privati e NON va mai su git.

# Chiave segreta di Django: generane una nuova (vedi README)
DJANGO_SECRET_KEY=scrivi-qui-una-chiave-lunga-e-casuale

# True solo sul proprio PC per sviluppo; su un server deve essere False
DJANGO_DEBUG=True

# Database PostgreSQL
DB_NAME=hub
DB_USER=postgres
DB_PASSWORD=scrivi-qui-la-tua-password
DB_HOST=localhost
DB_PORT=5432
# Connessione cifrata al database: prefer sul PC, require su Azure
DB_SSLMODE=prefer

# --- Solo su un server (lasciare vuoto sul proprio PC) ---
# Indirizzi da cui accettare richieste, separati da virgola
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Indirizzi https fidati per i moduli, es. https://hub.adeimichei.com
DJANGO_CSRF_TRUSTED_ORIGINS=
